{
  "manifest_version": 3,
  "name": "LeetCode Student Buddy",
  "version": "1.0",
  "description": "An AI mentor providing Socratic hints and code feedback directly on LeetCode.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.openai.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "scripts/content.js"
      ]
    }
  ]
}